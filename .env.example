# Local web + worker (npm run dev). Docker Compose overrides the hosts for postgres and redis.
DATABASE_URL=postgresql://blocker:blocker@localhost:5432/blocker
REDIS_URL=redis://localhost:6379

# Spotify redirect URI is ${APP_URL}/callback/spotify
# Loopback HTTP is allowed. Use 127.0.0.1, not localhost, and paste it exactly.
APP_URL=http://127.0.0.1:3000

# 32 bytes. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Only while rotating ENCRYPTION_KEY: the old key, so existing values still
# decrypt. Run `npm run reencrypt -- --apply`, then remove it.
# ENCRYPTION_KEY_PREVIOUS=

# Optional, 32+ characters. Signs session cookies instead of a key derived
# from ENCRYPTION_KEY.
# SESSION_SECRET=

# invite (default): sign-up only through an approved early-access invite.
# open: anyone can create an account.
SIGNUPS=invite

# This address becomes the admin on sign-up or login, and can always sign up. Optional.
ADMIN_EMAIL=

# Email: verification, password reset, and Spotify notices.
# Production: set RESEND_API_KEY and MAIL_FROM (Resend's HTTPS API; Railway's
# Hobby plan blocks SMTP). Resend wins when both are set.
# RESEND_API_KEY=
# MAIL_FROM=OnlySongs <hello@your.domain>
#
# Locally, Mailpit from docker-compose.dev.yml catches mail at 127.0.0.1:1025
# (inbox at :8025). With neither set, the app logs each email instead, and a
# deployment with an https:// APP_URL refuses to start.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Production Compose only. DNS name Caddy will obtain a certificate for.
APP_DOMAIN=
