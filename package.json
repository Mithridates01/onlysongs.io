{
  "name": "onlysongs",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --packages=external --outfile=dist/worker.js --format=cjs",
    "start": "next start -H 0.0.0.0 -p 3000",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "load-test": "tsx scripts/load/run.ts",
    "reencrypt": "tsx scripts/reencrypt.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "nodemailer": "^7.0.6",
    "prisma": "^6.19.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.25.10",
    "pg": "^8.23.1",
    "railway": "^3.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
